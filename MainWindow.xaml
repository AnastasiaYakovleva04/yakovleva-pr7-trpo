<Window x:Class="yakovleva_pr7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:yakovleva_pr7"
        mc:Ignorable="d"
        Title="MainWindow" Width="800"
        Padding="5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid x:Name="RegPanel" Grid.RowSpan="2" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Label Margin="2" Content="Имя:" Grid.Row="0" Grid.Column="0"/>
            <Label Margin="2" Content="Фамилия:" Grid.Row="1" Grid.Column="0"/>
            <Label Margin="2" Content="Отчество:" Grid.Row="2" Grid.Column="0"/>
            <Label Margin="2" Content="Специальность:" Grid.Row="3" Grid.Column="0"/>
            <Label Margin="2" Content="Пароль:" Grid.Row="4" Grid.Column="0"/>
            <Label Margin="2" Content="Подтвердите пароль:" Grid.Row="5" Grid.Column="0"/>

            <TextBox Text="{Binding Name, Mode=TwoWay}" Margin="2" Grid.Row="0" Grid.Column="1" />
            <TextBox Text="{Binding Surname, Mode=TwoWay}" Margin="2" Grid.Row="1" Grid.Column="1" />
            <TextBox Text="{Binding Patronimic, Mode=TwoWay}" Margin="2" Grid.Row="2" Grid.Column="1" />
            <TextBox Text="{Binding Specialization, Mode=TwoWay}" Margin="2" Grid.Row="3" Grid.Column="1" />
            <TextBox Text="{Binding Password, Mode=OneWayToSource}" Margin="2" Grid.Row="4" Grid.Column="1"/>
            <TextBox Text="{Binding ConfirmPassword, Mode=OneWayToSource}" Margin="2" Grid.Row="5" Grid.Column="1"/>

            <Button Name="RegBtn" Margin="2" Grid.ColumnSpan="2" Grid.Row="6" Content="Регистрация" Click="RegBtn_Click"/>
        </Grid>

        <Grid x:Name="LoginPanel"  Grid.Row="2" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Label Margin="2" Content="ID:" Grid.Row="0" Grid.Column="0"/>
            <Label Margin="2" Content="Пароль:" Grid.Row="1" Grid.Column="0"/>

            <TextBox Text="{Binding Id, Mode=OneWayToSource}" Margin="2" Grid.Row="0" Grid.Column="1" MaxLength="5"/>
            <TextBox Text="{Binding Password, Mode=OneWayToSource}" Margin="2" Grid.Row="1" Grid.Column="1" />

            <Button Name="LoginBtn" Margin="2" Grid.ColumnSpan="2" Grid.Row="2" Content="Вход" Click="LoginBtn_Click"/>
        </Grid>

        <StackPanel x:Name="DocInfoPanel" Orientation="Vertical" Margin="2" Grid.Row="3" Grid.Column="0">
            <StackPanel Orientation="Horizontal">
                <Label Margin="2" Content="ID:" />
                <Label Margin="2" Content="{Binding Id, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Margin="2" Content="Имя:" />
                <Label Margin="2" Content="{Binding Name, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Margin="2" Content="Фамилия:"/>
                <Label Margin="2" Content="{Binding Surname, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Margin="2" Content="Отчество:"/>
                <Label Margin="2" Content="{Binding Patronimic, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Margin="2" Content="Специальность:"/>
                <Label Margin="2" Content="{Binding Specialization, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>



        <Grid x:Name="AddPacPanel" Grid.Column="2" Grid.Row="0" Grid.RowSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Label Margin="2" Content="Имя:" Grid.Row="0" Grid.Column="0"/>
            <Label Margin="2" Content="Фамилия:" Grid.Row="1" Grid.Column="0"/>
            <Label Margin="2" Content="Отчество:" Grid.Row="2" Grid.Column="0"/>
            <Label Margin="2" Content="Дата рождения:" Grid.Row="3" Grid.Column="0"/>
            <Label Margin="2" Content="Последний визит:" Grid.Row="4" Grid.Column="0"/>
            <Label Margin="2" Content="Диагноз:" Grid.Row="5" Grid.Column="0"/>
            <Label Margin="2" Content="Рекоммендации:" Grid.Row="6" Grid.Column="0"/>

            <TextBox Text="{Binding Name, Mode=TwoWay}" Margin="2" Grid.Row="0" Grid.Column="1" />
            <TextBox Text="{Binding Surname, Mode=TwoWay}" Margin="2" Grid.Row="1" Grid.Column="1" />
            <TextBox Text="{Binding Patronimic, Mode=TwoWay}" Margin="2" Grid.Row="2" Grid.Column="1" />
            <DatePicker SelectedDate="{Binding Birthday, Mode=TwoWay}" DisplayDateStart="1920-01-01" DisplayDateEnd="{x:Static system:DateTime.Today}" Margin="2" Grid.Row="3" Grid.Column="1"/>
            <DatePicker SelectedDate="{Binding LastAppointment, Mode=TwoWay}" DisplayDateStart="1920-01-01" DisplayDateEnd="{x:Static system:DateTime.Today}" Margin="2" Grid.Row="4" Grid.Column="1"/>
            <TextBox Text="{Binding Diagnosis, Mode=TwoWay}" Margin="2" Grid.Row="5" Grid.Column="1"/>
            <TextBox Text="{Binding Recomendations, Mode=TwoWay}" Margin="2" Grid.Row="6" Grid.Column="1"/>

            <Button Name="AddPacientBtn" Margin="2" Grid.ColumnSpan="2" Grid.Row="7" Content="Добавить пациента" Click="AddPacientBtn_Click"/>
        </Grid>

        <Grid x:Name="EditPacPanel" Grid.Column="2" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Label Content="Имя:" Grid.Row="0" Grid.Column="0"/>
            <Label Content="Фамилия:" Grid.Row="1" Grid.Column="0"/>
            <Label Content="Отчество:" Grid.Row="2" Grid.Column="0"/>
            <Label Content="Дата рождения:" Grid.Row="3" Grid.Column="0"/>

            <TextBox Text="{Binding Name, Mode=TwoWay}" Margin="2" Grid.Row="0" Grid.Column="1" />
            <TextBox Text="{Binding Surname, Mode=TwoWay}" Margin="2" Grid.Row="1" Grid.Column="1" />
            <TextBox Text="{Binding Patronimic, Mode=TwoWay}" Margin="2" Grid.Row="2" Grid.Column="1" />
            <DatePicker SelectedDate="{Binding Birthday, Mode=TwoWay}" DisplayDateStart="1920-01-01" DisplayDateEnd="{x:Static system:DateTime.Today}" Margin="2" Grid.Row="3" Grid.Column="1"/>
            
            <Button Name="ResetPacientBtn" Margin="2" Grid.Row="4" Content="Сбросить" Click="ResetPacientBtn_Click"/>
            <Button Name="SaveChangesPacientBtn" Margin="2" Grid.Row="4" Grid.Column="1" Content="Сохранить" Click="SaveChangesPacientBtn_Click"/>
        </Grid>

        

        <StackPanel x:Name="SearchPacPanel" Orientation="Horizontal" Grid.Column="1" Grid.Row="0">
            <Label Content="ID:"/>
            <TextBox Text="{Binding Id, Mode=TwoWay}" 
             Width="190" Margin="2" Name="SearchIdTextBox"/>
            <Button Name="SearchPacientBtn" Margin="2" Content="Найти" Click="SearchPacientBtn_Click"/>
        </StackPanel>

        <StackPanel x:Name="PacInfoPanel" Orientation="Vertical" Grid.Row="1" Grid.RowSpan="3" Grid.Column="1">
            <Label Margin="2" Content="{Binding Name, Mode=OneWay}"/>
            <Label Margin="2" Content="{Binding Surname, Mode=OneWay}"/>
            <Label Margin="2" Content="{Binding Patronimic, Mode=OneWay}"/>
            <Label Margin="2" Content="{Binding Birthday, Mode=OneWay}"/>
            <Label Margin="2" Content="{Binding LastAppointment, Mode=OneWay}"/>
            <Label Margin="2" Content="{Binding LastDoctor, Mode=OneWay}"/>
            <Label Margin="2" Content="{Binding Diagnosis, Mode=OneWay}"/>
            <Label Margin="2" Content="{Binding Recomendations, Mode=OneWay}"/>
        </StackPanel>


        <StackPanel x:Name="SystemStatusPanel" Orientation="Horizontal" Grid.Row="4" Grid.ColumnSpan="3">
            <Label Margin="2" Content="Докторов: "/>
            <Label Margin="2" Content="{Binding DoctorsCount}"/>
            <Label Margin="2" Content="Пациентов:"/>
            <Label Margin="2" Content="{Binding PacientsCount}"/>
        </StackPanel>
    </Grid>
</Window>
