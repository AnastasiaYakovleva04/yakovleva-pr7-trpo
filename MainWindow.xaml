<Window x:Class="yakovleva_pr7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:yakovleva_pr7"
        mc:Ignorable="d"
        Title="MainWindow" Height="515" Width="800"
        Padding="5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid Grid.RowSpan="2" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Label Margin="2" Content="Имя:" Grid.Row="0" Grid.Column="0"/>
            <Label Margin="2" Content="Фамилия:" Grid.Row="1" Grid.Column="0"/>
            <Label Margin="2" Content="Отчество:" Grid.Row="2" Grid.Column="0"/>
            <Label Margin="2" Content="Специальность:" Grid.Row="3" Grid.Column="0"/>
            <Label Margin="2" Content="Пароль:" Grid.Row="4" Grid.Column="0"/>
            <Label Margin="2" Content="Подтвердите пароль:" Grid.Row="5" Grid.Column="0"/>

            <TextBox Name="NameTextBox"  Margin="2" Grid.Row="0" Grid.Column="1" />
            <TextBox Name="SurnameTextBox" Margin="2" Grid.Row="1" Grid.Column="1" />
            <TextBox Name="PatronimicTextBox" Margin="2" Grid.Row="2" Grid.Column="1" />
            <TextBox Name="SpecTextBox" Margin="2" Grid.Row="3" Grid.Column="1" />
            <TextBox Name="PassTextBox" Margin="2" Grid.Row="4" Grid.Column="1"/>
            <TextBox Name="ConfirmPassTextBox" Margin="2" Grid.Row="5" Grid.Column="1"/>

            <Button Name="RegBtn" Margin="2" Grid.ColumnSpan="2" Grid.Row="6" Content="Регистрация" Click="RegBtn_Click"/>
        </Grid>
        
        <Grid Grid.Row="2" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Label Margin="2" Content="ID:" Grid.Row="0" Grid.Column="0"/>
            <Label Margin="2" Content="Пароль:" Grid.Row="1" Grid.Column="0"/>

            <TextBox Name="IDTextBox" Margin="2" Grid.Row="0" Grid.Column="1"/>
            <TextBox Name="PassLoginTextBox" Margin="2" Grid.Row="1" Grid.Column="1" MaxLength="5"/>
            
            <Button Name="LoginBtn" Margin="2" Grid.ColumnSpan="2" Grid.Row="2" Content="Вход" Click="LoginBtn_Click"/>
        </Grid>

        <StackPanel Orientation="Vertical" Margin="2" Grid.Row="3" Grid.Column="0">
            <StackPanel Orientation="Horizontal">
                <Label Margin="2" Content="ID:" />
                <Label Margin="2" Content="{Binding Id}" />
            </StackPanel>
            
            <StackPanel Orientation="Horizontal">
                <Label Margin="2" Content="Имя:" />
                <Label Margin="2" Content="{Binding Name}" />
            </StackPanel>
            
            <StackPanel Orientation="Horizontal">
                <Label Margin="2" Content="Фамилия:"/>
                <Label Margin="2" Content="{Binding Surname}" />
            </StackPanel>
            
            <StackPanel Orientation="Horizontal">
                <Label Margin="2" Content="Отчество:"/>
                <Label Margin="2" Content="{Binding Patronimic}" />
            </StackPanel>
            
            <StackPanel Orientation="Horizontal">
                <Label Margin="2" Content="Специальность:"/>
                <Label Margin="2" Content="{Binding Specialization}" />
            </StackPanel>
        </StackPanel>
        


    </Grid>
</Window>
