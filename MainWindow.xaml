<Window x:Class="yakovleva_pr7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:yakovleva_pr7"
        xmlns:validators="clr-namespace:yakovleva_pr7.ValidationRules"
        mc:Ignorable="d"
        Title="MainWindow"
        Padding="5"
        Style="{DynamicResource Windw}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>


        <Frame Name="MainFrame" NavigationUIVisibility="Hidden" Grid.ColumnSpan="2"/>
        <Menu Grid.Column="1" Style="{DynamicResource Menuu}">
            <MenuItem Header="Настройки" Style="{DynamicResource Menuitem}">
                <MenuItem Header="Сменить тему" Click="ChangeTheme_Click"/>
            </MenuItem>
        </Menu>
    </Grid>
</Window>
