<Page x:Class="yakovleva_pr7.Pages.AddmissionPacientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:yakovleva_pr7.Pages"
      xmlns:system="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d" 
      Title="AddmissionPacientPage">

    <Grid Width="600" Height="290">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="4*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <StackPanel Name="PacInfoPanel" Grid.Row="0" Grid.ColumnSpan="2" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <Label Content="Фамилия" Style="{DynamicResource Lable}"/>
                <Label Content="{Binding Surname, Mode=OneWay}" Style="{DynamicResource Lable}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Имя" Style="{DynamicResource Lable}"/>
                <Label Content="{Binding Name, Mode=OneWay}" Style="{DynamicResource Lable}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Отчество" Style="{DynamicResource Lable}"/>
                <Label Content="{Binding Patronimic, Mode=OneWay}" Style="{DynamicResource Lable}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label  Content="Дата рождения" Style="{DynamicResource Lable}"/>
                <Label  Content="{Binding Birthday, Mode=OneWay}" Style="{DynamicResource Lable}"/>
            </StackPanel>
        </StackPanel>

        <Label Grid.Row="1" Grid.Column="0" Content="Дата: " Style="{DynamicResource Lable}"/>
        <Label Grid.Row="2" Grid.Column="0" Content="Диагноз: " Style="{DynamicResource Lable}"/>
        <Label Grid.Row="3" Grid.Column="0" Content="Рекоммендации: " Style="{DynamicResource Lable}"/>
        
        <Grid x:Name="AddmissionPanel" Grid.Row="1" Grid.RowSpan="3" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <DatePicker Grid.Row="0"  SelectedDate="{Binding Date, Mode=TwoWay}" DisplayDateStart="1920-01-01" DisplayDateEnd="{x:Static system:DateTime.Today}" Style="{DynamicResource Datepicker}"/>
            <TextBox Grid.Row="1" Text="{Binding Diagnosis, Mode=TwoWay}" Style="{DynamicResource Textbox}"/>
            <TextBox Grid.Row="2" Text="{Binding Recommendations, Mode=TwoWay}" Style="{DynamicResource Textbox}"/>
        </Grid>

        <Button x:Name="BackBtn" Grid.Row="4" Grid.Column="0"  Content="Назад" Style="{DynamicResource StrokeButton}" Click="BackBtn_Click"/>
        <Button x:Name="SaveAddmissionBtn" Grid.Row="4" Grid.Column="1"  Content="Сохранить" Style="{DynamicResource DefaultButton}" Click="SaveAddmissionBtn_Click"/>


        <ListView ItemsSource="{Binding PacientAppointmentStory}" Grid.Column="2" Grid.RowSpan="5" Style="{DynamicResource Listview}" ItemContainerStyle="{DynamicResource ListviewItem}">
            <ListView.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource Scrollbar}"/>
            </ListView.Resources>
            
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel x:Name="PacInfoPanel" Orientation="Vertical" Grid.Row="1" Grid.RowSpan="3" Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{DynamicResource Lable}" Content="Дата"/>
                            <Label Style="{DynamicResource Lable}" Content="{Binding Date, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{DynamicResource Lable}" Content="ID врача"/>
                            <Label Style="{DynamicResource Lable}" Content="{Binding DoctorId, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{DynamicResource Lable}" Content="Диагноз"/>
                            <Label Style="{DynamicResource Lable}" Content="{Binding Diagnosis, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{DynamicResource Lable}" Content="Рекоммендации"/>
                            <Label Style="{DynamicResource Lable}" Content="{Binding Recommendations, Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
