<Page x:Class="yakovleva_pr7.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:yakovleva_pr7.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegistrationPage"
      Background="White">

    <Grid x:Name="RegPanel" Grid.Column="0" Width="300" Height="250">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Margin="2" Content="Имя:" Grid.Row="0" Grid.Column="0"/>
        <Label Margin="2" Content="Фамилия:" Grid.Row="1" Grid.Column="0"/>
        <Label Margin="2" Content="Отчество:" Grid.Row="2" Grid.Column="0"/>
        <Label Margin="2" Content="Специальность:" Grid.Row="3" Grid.Column="0"/>
        <Label Margin="2" Content="Пароль:" Grid.Row="4" Grid.Column="0"/>
        <Label Margin="2" Content="Подтвердите пароль:" Grid.Row="5" Grid.Column="0"/>

        <TextBox Text="{Binding Name, Mode=TwoWay}" Margin="2" Grid.Row="0" Grid.Column="1" />
        <TextBox Text="{Binding Surname, Mode=TwoWay}" Margin="2" Grid.Row="1" Grid.Column="1" />
        <TextBox Text="{Binding Patronimic, Mode=TwoWay}" Margin="2" Grid.Row="2" Grid.Column="1" />
        <TextBox Text="{Binding Specialization, Mode=TwoWay}" Margin="2" Grid.Row="3" Grid.Column="1" />
        <TextBox Text="{Binding Password, Mode=OneWayToSource}" Margin="2" Grid.Row="4" Grid.Column="1"/>
        <TextBox Text="{Binding ConfirmPassword, Mode=OneWayToSource}" Margin="2" Grid.Row="5" Grid.Column="1"/>

        <Button Name="BackBtn" Margin="2" Grid.Row="6" Grid.Column="0" Content="Назад" Click="BackBtn_Click"/>
        <Button Name="RegBtn" Margin="2" Grid.Column="1" Grid.Row="6" Content="Регистрация" Click="RegBtn_Click"/>
    </Grid>
</Page>
