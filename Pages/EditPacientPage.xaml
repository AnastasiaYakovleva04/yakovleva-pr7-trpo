<Page x:Class="yakovleva_pr7.Pages.EditPacientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:yakovleva_pr7.Pages"
      xmlns:system="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d" 
      Title="EditPacientPage">

    <Grid x:Name="EditPacPanel" Width="300" Height="300">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Content="Имя:" Grid.Row="0" Grid.Column="0" Style="{DynamicResource Lable}"/>
        <Label Content="Фамилия:" Grid.Row="1" Grid.Column="0" Style="{DynamicResource Lable}"/>
        <Label Content="Отчество:" Grid.Row="2" Grid.Column="0" Style="{DynamicResource Lable}"/>
        <Label Content="Дата рождения:" Grid.Row="3" Grid.Column="0" Style="{DynamicResource Lable}"/>
        <Label Content="Номер телефона:" Grid.Row="4" Grid.Column="0" Style="{DynamicResource Lable}"/>

        <TextBox Text="{Binding Name, Mode=TwoWay}" Style="{DynamicResource Textbox}" Grid.Row="0" Grid.Column="1" />
        <TextBox Text="{Binding Surname, Mode=TwoWay}" Style="{DynamicResource Textbox}" Grid.Row="1" Grid.Column="1" />
        <TextBox Text="{Binding Patronimic, Mode=TwoWay}" Style="{DynamicResource Textbox}" Grid.Row="2" Grid.Column="1" />
        <DatePicker SelectedDate="{Binding Birthday, Mode=TwoWay}" DisplayDateStart="1920-01-01" DisplayDateEnd="{x:Static system:DateTime.Today}" Style="{DynamicResource Datepicker}" Grid.Row="3" Grid.Column="1"/>
        <TextBox Text="{Binding PhoneNumber, Mode=TwoWay}" Style="{DynamicResource Textbox}" Grid.Row="4" Grid.Column="1"/>

        <Button Name="ResetPacientBtn" Style="{DynamicResource StrokeButton}" Margin="2" Grid.Row="5" Grid.Column="1" Content="Сбросить" Click="ResetPacientBtn_Click"/>
        <Button Name="BackBtn" Style="{DynamicResource StrokeButton}" Grid.Row="5" Content="Назад" Click="BackBtn_Click"/>
        <Button Name="SaveChangesPacientBtn" Style="{DynamicResource DefaultButton}" Margin="2" Grid.Row="6" Grid.ColumnSpan="2" Content="Сохранить" Click="SaveChangesPacientBtn_Click" Width="296"/>
    </Grid>
</Page>
