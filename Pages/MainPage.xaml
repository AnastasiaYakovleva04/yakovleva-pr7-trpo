<Page x:Class="yakovleva_pr7.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:system="clr-namespace:System;assembly=mscorlib"
      xmlns:local="clr-namespace:yakovleva_pr7.Pages"
      mc:Ignorable="d"  d:DesignWidth="800"
      Title="MainPage"
      Background="White">

    <StackPanel Orientation="Vertical">
        <StackPanel x:Name="DocInfoPanel" Orientation="Horizontal"  Margin="2" Grid.Row="3" Grid.Column="0">
            <Label Margin="2" Content="ID:" />
            <Label Margin="2" Content="{Binding Id, Mode=OneWay}" />
            <Label Margin="2" Content="{Binding Surname, Mode=OneWay}" />
            <Label Margin="2" Content="{Binding Name, Mode=OneWay}" />
            <Label Margin="2" Content="{Binding Patronimic, Mode=OneWay}" />
            <Label Margin="2" Content="{Binding Specialization, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="AddPacientBtn" Margin="2"  Content="Создать пациента" Click="AddPacientBtn_Click"></Button>
            <Button Name="StartAddmissionBtn" Margin="2"  Content="Начать прием" Click="StartAddmissionBtn_Click"></Button>
            <Button Name="EditPacientBtn" Margin="2"  Content="Изменить информацию" Click="EditPacientBtn_Click"></Button>
        </StackPanel>

        <ListView ItemsSource="{Binding Pacients}" SelectedItem="{Binding SelectedPacient}" Height="350">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel x:Name="PacInfoPanel" Orientation="Vertical" Grid.Row="1" Grid.RowSpan="3" Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <Label Margin="2" Content="Фамилия"/>
                            <Label Margin="2" Content="{Binding Surname, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Margin="2" Content="Имя"/>
                            <Label Margin="2" Content="{Binding Name, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Margin="2" Content="Отчество"/>
                            <Label Margin="2" Content="{Binding Patronimic, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Margin="2" Content="Дата рождения"/>
                            <Label Margin="2" Content="{Binding Birthday, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Margin="2" Content="Номер телефона"/>
                            <Label Margin="2" Content="{Binding PhoneNumber, Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Orientation="Horizontal">
            <StackPanel x:Name="SystemStatusPanel" Orientation="Horizontal">
                <Label Content="Докторов:"/>
                <Label Content="{Binding DoctorsCount}"/>
            </StackPanel>
            <Label Content="Пациентов:"/>
            <Label Content="{Binding Pacients.Count}"/>
        </StackPanel>
    </StackPanel>
</Page>

