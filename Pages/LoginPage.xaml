<Page x:Class="yakovleva_pr7.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:yakovleva_pr7.Pages"
      mc:Ignorable="d" 
      Title="LoginPage">


    <Grid x:Name="LoginPanel" Grid.Column="1"  Width="300" Height="120">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Style="{DynamicResource Lable}" Content="ID:" Grid.Row="0" Grid.Column="0"/>
        <Label Style="{DynamicResource Lable}" Content="Пароль:" Grid.Row="1" Grid.Column="0"/>

        <TextBox Text="{Binding Id, Mode=OneWayToSource}" Style="{DynamicResource Textbox}" Grid.Row="0" Grid.Column="1" MaxLength="5"/>
        <TextBox Text="{Binding Password, Mode=OneWayToSource}" Style="{DynamicResource Textbox}" Grid.Row="1" Grid.Column="1" />

        <Button Name="RegBtn" Grid.Row="2" Grid.Column="0" Content="Регистрация" Click="RegBtn_Click" Style="{DynamicResource StrokeButton}"/>
        <Button Name="LoginBtn" Grid.Row="2" Grid.Column="1" Content="Вход" Click="LoginBtn_Click" Style="{DynamicResource DefaultButton}"/>
    </Grid>
</Page>
