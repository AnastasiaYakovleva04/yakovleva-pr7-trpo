<Page x:Class="yakovleva_pr7.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:yakovleva_pr7.Pages"
      xmlns:validators="clr-namespace:yakovleva_pr7.ValidationRules"
      mc:Ignorable="d" 
      Title="LoginPage">


    <Grid x:Name="LoginPanel" Grid.Column="1"  Width="300" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Style="{DynamicResource Lable}" Content="ID:" Grid.Row="0" Grid.Column="0"/>
        <Label Style="{DynamicResource Lable}" Content="Пароль:" Grid.Row="2" Grid.Column="0"/>

        <TextBox x:Name="IdTextBox" Style="{DynamicResource Textbox}" Grid.Row="0" Grid.Column="1" MaxLength="5">
            <TextBox.Text>
                <Binding Path="Id" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <validators:IsEmptyRule/>
                        <validators:IsNumberRule/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>

        <ItemsControl Grid.Row="1" Grid.Column="1" Grid.RowSpan="1"
                      Foreground="{DynamicResource ErrorStyle}" FontSize="10"
                      ItemsSource="{Binding ElementName=IdTextBox, Path=(Validation.Errors)}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBox x:Name="PasswordTextBox" Style="{DynamicResource Textbox}" Grid.Row="2" Grid.Column="1">
            <TextBox.Text>
                <Binding Path="Password" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <validators:IsEmptyRule/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>

        <ItemsControl Grid.Row="3" Grid.Column="1" Grid.RowSpan="1"
                      Foreground="{DynamicResource ErrorStyle}" FontSize="10"
                      ItemsSource="{Binding ElementName=PasswordTextBox, Path=(Validation.Errors)}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        
        <Button Name="RegBtn" Grid.Row="4" Grid.Column="0" Content="Регистрация" Click="RegBtn_Click" Style="{DynamicResource AddButton}"/>
        <Button Name="LoginBtn" Grid.Row="4" Grid.Column="1" Content="Вход" Click="LoginBtn_Click" Style="{DynamicResource DefaultButton}"/>
    </Grid>
</Page>
