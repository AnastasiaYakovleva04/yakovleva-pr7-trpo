<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Window -->
    <Style TargetType="Window" x:Key="Windw">
        <Setter Property="Width" Value="800"/>
        <Setter Property="Height" Value="650"/>
        <Setter Property="Background" Value="{DynamicResource MaterialDesignPrimaryBackground}"/>
    </Style>

    <!-- Кнопки -->
    <Style TargetType="Button" x:Key="DefaultButton" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{DynamicResource MaterialDesignPrimaryButton}"/>
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignSecondaryBackground}"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="15"/>
    </Style>

    <Style TargetType="Button" x:Key="StrokeButton" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignPrimaryButton}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignPrimaryButton}"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Width" Value="145"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="15"/>
    </Style>

    <Style TargetType="Button" x:Key="DeleteButton" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{DynamicResource MaterialDesignDangerousButton}"/>
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignSecondaryBackground}"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="15"/>
    </Style>

    <!-- TextBox -->
    <Style TargetType="TextBox" x:Key="Textbox" BasedOn="{StaticResource MaterialDesignFilledTextBox}">
        <Setter Property="Background" Value="{DynamicResource MaterialDesignInputBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignPrimaryText}"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="145"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="IsReadOnly" Value="False"/>
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{DynamicResource MaterialDesignPrimaryButton}"/>
    </Style>

    <!-- Labels -->
    <Style TargetType="Label" x:Key="Lable">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignPrimaryText}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignPrimaryText}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="Label" x:Key="SecondaryText">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignSecondaryText}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="Label" x:Key="Title">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignPrimaryTitle}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="20"/>
    </Style>

    <!-- DatePicker -->
    <Style TargetType="DatePicker" x:Key="Datepicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Width" Value="145"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{DynamicResource MaterialDesignPrimaryButton}"/>
        <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource MaterialDesignSecondaryText}"/>
    </Style>

    <!-- ListView -->
    <Style TargetType="ListView" x:Key="Listview" BasedOn="{StaticResource MaterialDesignListView}">
        <Setter Property="Background" Value="{DynamicResource MaterialDesignSecondaryBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="MaxHeight" Value="400"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style TargetType="ListViewItem" x:Key="ListviewItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="materialDesign:ListBoxItemAssist.CornerRadius" Value="15"/>
        <Setter Property="materialDesign:RippleAssist.Feedback" Value="{DynamicResource MaterialDesignAccent}"/>

        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource MaterialDesignAccent}"/>
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignSecondaryBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignAccent}"/>
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource MaterialDesignAccent}"/>
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignSecondaryBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignAccent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Border -->
    <Style TargetType="Border" x:Key="Bordr">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- StackPanel -->
    <Style TargetType="StackPanel" x:Key="Panel">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Orientation" Value="Horizontal"/>
    </Style>

    <Style TargetType="StackPanel" x:Key="SpecialPanel">
        <Setter Property="Background" Value="{DynamicResource MaterialDesignSecondaryBackground}"/>
        <Setter Property="Orientation" Value="Horizontal"/>
    </Style>

    <!-- ScrollBar -->
    <Style TargetType="ScrollBar" x:Key="Scrollbar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="10"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder"
                                                    Background="{DynamicResource MaterialDesignPrimaryButton}"
                                                    CornerRadius="4"
                                                    SnapsToDevicePixels="True"
                                                    Width="6"/>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource MaterialDesignAccent}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource MaterialDesignAccent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu -->
    <Style TargetType="Menu" x:Key="Menuu" BasedOn="{StaticResource MaterialDesignMenu}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignAccent}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Width" Value="70"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style TargetType="MenuItem" x:Key="Menuitem" BasedOn="{StaticResource MaterialDesignMenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignAccent}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>