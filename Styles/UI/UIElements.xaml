<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="Window" x:Key="Windw">
        <Setter Property="Width" Value="800"/>
        <Setter Property="Height" Value="550"/>
        <Setter Property="Background" Value="{DynamicResource WhiteStyle}"/>
    </Style>
    
    <Style TargetType="Button" x:Key="DefaultButton">
        <Setter Property="Background" Value="{DynamicResource BlueStyle}"/>
        <Setter Property="Foreground" Value="{DynamicResource LightblueStyle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BlueStyle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Width" Value="145"/>
        <Setter Property="Height" Value="30"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DeepBlueStyle}"/>
                <Setter Property="Foreground" Value="{DynamicResource WhiteStyle}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DeepBlueStyle}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource DarkblueStyle}"/>
                <Setter Property="Foreground" Value="{DynamicResource WhiteStyle}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DarkblueStyle}"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <Style TargetType="Button" x:Key="StrokeButton" BasedOn="{StaticResource DefaultButton}">
        <Setter Property="Background" Value="{DynamicResource WhiteStyle}"/>
        <Setter Property="Foreground" Value="{DynamicResource BlueStyle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BlueStyle}"/>
        
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DeepBlueStyle}"/>
                <Setter Property="Foreground" Value="{DynamicResource WhiteStyle}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DeepBlueStyle}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource DarkblueStyle}"/>
                <Setter Property="Foreground" Value="{DynamicResource WhiteStyle}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DarkblueStyle}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" x:Key="AddButton" BasedOn="{StaticResource StrokeButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="15"
                        Padding="{TemplateBinding Padding}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Label Content="+" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DeepBlueStyle}"/>
                <Setter Property="Foreground" Value="{DynamicResource WhiteStyle}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DeepBlueStyle}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource DarkblueStyle}"/>
                <Setter Property="Foreground" Value="{DynamicResource WhiteStyle}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DarkblueStyle}"/>
            </Trigger>
        </Style.Triggers>
    </Style>



    <Style TargetType="TextBox" x:Key="Textbox">
        <Setter Property="Background" Value="{DynamicResource WhiteStyle}"/>
        <Setter Property="Foreground" Value="{DynamicResource BlueStyle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BlueStyle}"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Width" Value="145"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="IsReadOnly" Value="False"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Margin="5,0,0,0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource LightblueStyle}"/>
                <Setter Property="Foreground" Value="{DynamicResource DarkblueStyle}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DarkblueStyle}"/>
            </Trigger>
        </Style.Triggers>
    </Style>



    <Style TargetType="Label" x:Key="Lable">
        <Setter Property="Foreground" Value="{DynamicResource DarkblueStyle}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>


    <Style TargetType="DatePickerTextBox" x:Key="DatepickerTextbox" BasedOn="{StaticResource Textbox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="DatePicker" x:Key="Datepicker" >
        <Setter Property="Background" Value="{DynamicResource WhiteStyle}"/>
        <Setter Property="Foreground" Value="{DynamicResource BlueStyle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BlueStyle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Width" Value="145"/>
        <Setter Property="Height" Value="30"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" Style="{DynamicResource DatepickerTextbox}"/>

                                <Button x:Name="PART_Button" Grid.Column="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Margin="5,0"
                                        Command="{Binding DropDownCommand, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Viewbox Width="12" Height="12">
                                        <Path Data="M2,2 L14,2 L14,14 L2,14 Z M3,2 L3,0 L5,0 L5,2 Z M11,2 L11,0 L13,0 L13,2 Z M2,5 L14,5" 
                                              Stroke="{TemplateBinding Foreground}" 
                                              StrokeThickness="1"
                                              Fill="Transparent"/>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="5">
                                <Calendar x:Name="PART_Calendar"
                                      SelectedDate="{Binding SelectedDate, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      IsTodayHighlighted="True"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}">
                                </Calendar>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource LightblueStyle}"/>
                <Setter Property="Foreground" Value="{DynamicResource DarkblueStyle}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DarkblueStyle}"/>
            </Trigger>
        </Style.Triggers>
    </Style>



    <Style TargetType="ListViewItem" x:Key="ListviewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkblueStyle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LightblueStyle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        Padding="5"
                        Margin="1"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource LightblueStyle}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DarkblueStyle}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DeepBlueStyle}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource LightblueStyle}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DarkblueStyle}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DeepBlueStyle}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListView" x:Key="Listview">
        <Setter Property="Background" Value="{DynamicResource WhiteStyle}"/>
        <Setter Property="Foreground" Value="{DynamicResource BlueStyle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LightblueStyle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="MaxHeight" Value="400"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    

    <Style TargetType="Border" x:Key="Bordr">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BlueStyle}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>



    <Style TargetType="StackPanel" x:Key="Panel">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Orientation" Value="Horizontal"/>
    </Style>

    <Style TargetType="StackPanel" x:Key="SpecialPanel">
        <Setter Property="Background" Value="{DynamicResource LightblueStyle}"/>
        <Setter Property="Orientation" Value="Horizontal"/>
    </Style>




    <Style TargetType="ScrollBar" x:Key="Scrollbar">
        <Setter Property="Background" Value="{DynamicResource WhiteStyle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BlueStyle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width" Value="8"/>


        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{DynamicResource BlueStyle}"
                                                CornerRadius="4"
                                                SnapsToDevicePixels="True"
                                                Width="6"/>
                                    
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DeepBlueStyle}"/>
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter  Property="Background" Value="{DynamicResource DarkblueStyle}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <Style TargetType="Menu" x:Key="Menuu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BlueStyle}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style TargetType="MenuItem" x:Key="Menuitem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BlueStyle}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>